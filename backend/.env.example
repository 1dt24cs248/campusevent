# Campus Intelligence & Action Platform - Environment Configuration
# Run 'python -m app.seed.gen_keys' to generate secrets before using confidential reports.
# Never leave JWT_SECRET or APP_ENCRYPTION_KEY set to the example value.

# Database (default: SQLite; change to PostgreSQL URL for production)
DATABASE_URL=sqlite:///./campus.db

# Security (replace both defaults with generated secrets)
JWT_SECRET=change-me
APP_ENCRYPTION_KEY=change-me

# Demo mode (shows quick-login chips on login page)
DEMO_MODE=true

# Campus timezone
CAMPUS_TZ=Asia/Kolkata

# AI Provider: none (rule-based, default) | gemini | anthropic | openai
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Solver
SOLVER_TIME_LIMIT_SEC=8

# Demo clock override (ISO format, e.g. 2026-10-06T08:30:00; empty = real time)
DEMO_NOW=
